                "--model_arch_type", "spar",
                "--use_stagnation_early_stop", "False",
                "--use_stagnation_velocity_signal", "True",
                "--use_stagnation_entropy_signal", "True",
                "--stagnation_patience", "20",
                "--stagnation_tolerance", "1e-4",
                "--stagnation_rel_tolerance", "0.05",
                "--stagnation_ema_beta", "0.99",
                "--stagnation_eps", "1e-8",
                "--stagnation_eval_games", "0",
                "--entropy_stagnation_weight", "1.0",
                "--stagnation_lr_factor", "0.999",
                "--stagnation_lr_patience", "10",
                "--use_wandb", "False",
                "--obs_type", "image",
                // Kept in sync with run_timescale_arm.sh and
                // slurm_launch_files/cds_style_template.slurm.
                //
                // V-trace master switch. When "False" every --vtrace_* flag is
                // INERT. Default in ippo.py is "True" (the committed behaviour).
                "--vtrace_enabled", "True",
                // PopArt value-target normalization. "True" wraps each value head
                // and RENAMES value_net state_dict keys, so a popart run cannot
                // load any checkpoint written without it -- start from scratch.
                "--popart", "False",
                "--popart_beta", "3e-4",
                // Kept in sync with run_minimax_phase0.sh. All three are INERT
                // while --minimax_q is False (ippo.py's default), which is the
                // case for this config -- they are here so the two launchers
                // stay in step, not because this run uses them.
                //
                // Joint-action critic parameterization. 'matrix' is the 484-cell
                // free head; 'factored' is V + A_ego + A_adv + e^T W(s) e --
                // 61 outputs and ~100% gradient density instead of 0.207%.
                "--minimax_head", "matrix",
                "--minimax_rank", "4",
                // What the head regresses onto. 'returns' = option A, the
                // lambda-returns (DATA, cannot diverge). 'minimax' = option B,
                // Littman's operator r + gamma*V_mm(s'), which is
                // self-referential -- watch train/minimax_q_scale against
                // train/minimax_target_scale, and note that minimax_ev and
                // minimax_target_corr stop being meaningful under it.
                "--minimax_target", "returns",
                // Analytic action-embedding basis from gamma_basis.py. Empty =
                // learn them, which measured 4.93% of the true interaction
                // against 3.63% for a random subspace; the computed basis
                // reaches 59.24% at rank 4 and 84.93% at rank 8. Frozen after
                // loading by default. Its rank MUST match --minimax_rank.
                "--minimax_embed", "",
                "--minimax_freeze_embed", "True",
                // Entropy saturation is ABSORBING: a policy at exactly zero
                // entropy has no probability mass to move, so its gradient is
                // zero and it can NEVER recover. MEASURED: p1_clr1e5_winit's
                // adversary hit it at 3.77M and the run spent 34M more steps as
                // single-agent RL against a frozen bot while its score curve
                // still looked plausible. ent_coef/dstb_ent_coef are 0.0, so
                // nothing else prevents this. "False" = warn but keep going.
                // Counterfactual enumeration. 0 = OFF and bitwise inert.
                // One transition trains ONE of 484 cells; fitting the full Q
                // from one cell per state recovers 0.95% of the true
                // interaction -- BELOW the 3.40% a random subspace scores.
                // Enumerating takes the real head from ~5% to ~58%. PRIVILEGED
                // (needs em.set_state), training-time only; branch steps are
                // logged as train/enum_env_steps so comparisons can be
                // budget-matched.
                // Entropy floor, per side. Both default 0.0 -- which is what
                // every run so far used. Zero entropy is ABSORBING (no mass to
                // move means no gradient) and killed one arm's adversary at
                // 3.77M. Kept separate because a bonus on one side of a
                // zero-sum game moves the equilibrium being solved for.
                // Re-init the EGO to max entropy on resume. An entropy
                // COEFFICIENT cannot escape a saturated policy: measured,
                // ent_coef 0.0/0.001/0.01 from a frozen-ego checkpoint gave
                // bit-identical runs, because the bonus gradient is also
                // proportional to movable probability mass.
                "--reinit_ego", "False",
                "--ent_coef", "0.0",
                "--dstb_ent_coef", "0.0",
                "--enum_every", "0",
                "--enum_k", "484",
                "--enum_buffer", "8",
                "--enum_loss_coef", "1.0",
                // Keep only enumerated states whose joint action actually
                // affects reward (judged on raw R). At 6-12% contact in healthy
                // self-play ~93% of states have gamma identically zero, and
                // averaging over them is the measured gating problem.
                "--enum_contact_only", "False",
                // Screen candidates with N cheap branches before paying 484.
                // 0 = off. Contact-state COUNT is the binding constraint, and
                // screening buys them ~13x cheaper.
                "--enum_probe", "0",
                "--enum_walk", "40",
                // Fraction of envs parked on contact. 1.0 measured corrW(R)
                // +0.028 -- worse than the natural 6.5% (+0.050) -- because a
                // head trained only where interaction exists learns to see it
                // everywhere. Needs --enum_contact_only False.
                "--enum_probe_frac", "1.0",
                "--entropy_collapse_abort", "True",
                "--entropy_collapse_tol", "1e-6",
                "--entropy_collapse_patience", "20",
                // PHASE 1 switch. 0.0 = the head feeds NOTHING and the code path
                // is not entered, so behaviour is BITWISE identical to Phase 0.
                // >0 blends V_minimax into the GAE bootstrap and the head starts
                // moving the policy -- and REQUIRES --gae_lambda 0, because the
                // minimax bootstrap is off-policy and a lambda-return mixes
                // on-policy rewards into it (unsound without a Retrace trace).
                "--minimax_bootstrap_kappa", "0.0",
                "--minimax_bootstrap_warmup", "0"
            ]
        },
