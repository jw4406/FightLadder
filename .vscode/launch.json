            "name": "Python Debugger: ippo.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main/ippo.py",
            "console": "integratedTerminal",
            "args": [
                "--player", "Guile",
                "--opponents", "Sagat",
                "--num_env_to_load", "1",
                "--env_batch_size", "24",
                "--c_lr", "1e-5",
